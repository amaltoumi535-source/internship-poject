# Environment Configuration Example
# Copy this file to .env and update with your actual values

# ============================================================================
# ENVIRONMENT & DEBUG
# ============================================================================
ENV=development
DEBUG=true
LOG_LEVEL=info

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
HOST=127.0.0.1
PORT=8000

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# CRITICAL: Change this to a secure random string in production
SECRET_KEY=your-super-secret-key-change-in-production-12345
# JWT token expiration time in minutes
JWT_EXPIRATION_MINUTES=30
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================================
# DATABASE
# ============================================================================
# SQLite (development)
DATABASE_URL=sqlite:///./app.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/itgate_db

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================
# Options: anthropic, openai, groq, ollama
LLM_PROVIDER=anthropic

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus

# OpenAI GPT
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Groq (fast inference)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=mixtral-8x7b-32768

# Ollama (local LLM server)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ============================================================================
# EMBEDDINGS & VECTOR STORE
# ============================================================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMADB_DIR=data/chromadb
ENABLE_VECTOR_STORE=true

# ============================================================================
# FILE HANDLING & PATHS
# ============================================================================
DATA_DIR=data
FILES_DIR=data/files

# Optional: System paths for external tools
# POPPLER_PATH=/usr/bin/poppler  # For PDF processing
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata  # For OCR

# ============================================================================
# EMAIL CONFIGURATION (for verification codes)
# ============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@itgate-agent.com

# ============================================================================
# SLACK INTEGRATION (Optional)
# ============================================================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# ============================================================================
# RATE LIMITING & QUOTAS
# ============================================================================
# Requests per minute per user
RATE_LIMIT_RPM=60
# Documents per user
MAX_DOCUMENTS_PER_USER=1000
# Upload file size limit (in MB)
MAX_FILE_SIZE_MB=50

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
LOG_TO_FILE=false
LOG_FILE_PATH=logs/app.log

# Optional: Sentry for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/12345
